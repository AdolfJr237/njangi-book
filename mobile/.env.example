# Copy this file to .env. .env is gitignored -- this value is specific
# to whatever machine/network you're developing on, it shouldn't be
# committed.
#
# You mostly don't need to touch this anymore. constants/config.ts now
# auto-detects the backend's address from Metro's own connection at
# runtime (Constants.expoConfig.hostUri) -- the same auto-detection
# `expo start --lan` already does for loading the app itself. Switching
# WiFi, hotspot, or the emulator no longer requires editing this file.
#
# EXPO_PUBLIC_API_URL below is only used as a fallback: for a production
# build (no dev server, no hostUri to read), where it should point at
# the real deployed backend, not a LAN address.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000

# Firebase Web configuration for the PWA. These are public app identifiers,
# not backend credentials. Copy their values from the Firebase Web app snippet.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
