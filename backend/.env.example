# Copy this file to .env and fill in real values. .env is gitignored on purpose —
# secrets never get committed.

# Local PostgreSQL example. Replace the placeholders, then run Alembic before
# starting the API: .\.venv\Scripts\python.exe -m alembic upgrade head
# SQLite remains possible for throwaway experiments, but PostgreSQL is the
# supported local database for this project.
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/njangibook

# Use development locally. Production refuses SQLite, a default/short JWT
# secret, wildcard CORS, and console-logged OTPs.
APP_ENVIRONMENT=development
# Browser origins only, comma-separated. Keep * for local development.
CORS_ORIGINS=*

# Used to sign JWTs. Generate a real random string before deploying:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# OTP delivery. "dev" logs codes to the backend terminal for local testing.
# A real sender must be implemented and configured before APP_ENVIRONMENT=production.
SMS_PROVIDER=dev

# Orange SMS Cameroon all-operators. Keep these only in backend/.env or your
# hosting provider's encrypted environment settings, never in mobile/.env.
ORANGE_SMS_CLIENT_ID=
ORANGE_SMS_CLIENT_SECRET=
ORANGE_SMS_SENDER_ADDRESS=tel:+2370000
# Set after Orange approves/whitelists the sender name. Leave blank to use
# Orange's generated default sender name during initial testing.
ORANGE_SMS_SENDER_NAME=
# Firebase Phone Authentication password recovery. Locally, point this to
# your ignored Admin SDK JSON key. On Render, set FIREBASE_SERVICE_ACCOUNT_JSON
# to the complete JSON value as an encrypted environment variable instead.
FIREBASE_SERVICE_ACCOUNT_PATH=secrets.json
# FIREBASE_SERVICE_ACCOUNT_JSON=
